{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Índice de skills do skill-scout",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lastUpdated", "sources", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "lastUpdated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "categories": { "type": "array", "items": { "$ref": "#/definitions/category" } },
    "sources": { "type": "array", "items": { "$ref": "#/definitions/source" } },
    "skills": { "type": "array", "items": { "$ref": "#/definitions/skill" } }
  },
  "definitions": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner", "url", "type", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://github\\.com/" },
        "type": { "enum": ["official", "awesome-list", "community"] },
        "description": { "type": "string" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "path", "categories", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "source": { "type": "string", "description": "id de uma fonte em sources" },
        "path": { "type": "string" },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    }
  }
}
